/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "elmybot-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./public",
		"binding": "BROWSER_ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"STATE_QUERY_STREAMS_ENABLED": "true",
		"STATE_QUERY_DIAGNOSTICS": "false",
		"STATE_QUERY_DEPLOYMENT_ENVIRONMENT": "production",
		"STATE_QUERY_PUBLIC_ORIGIN": "https://elmybot-worker.cutelmy.workers.dev",
		"DURABLE_EVENT_STREAMS_ENABLED": "true",
		"DURABLE_EVENT_DEPLOYMENT_ENVIRONMENT": "production",
		"DURABLE_EVENT_PUBLIC_ORIGIN": "https://elmybot-worker.cutelmy.workers.dev",
		"TWITCH_DEPLOYMENT_ENVIRONMENT": "production",
		"TWITCH_PUBLIC_ORIGIN": "https://elmybot-worker.cutelmy.workers.dev"
	},

	"durable_objects": {
		"bindings": [
			{ "name": "SCHEDULER", "class_name": "GroupScheduler" },
			{ "name": "CONFIG", "class_name": "GroupConfig" },
			{ "name": "TWITCH_APP_AUTH", "class_name": "TwitchAppAuth" },
			{ "name": "TWITCH_AUTH", "class_name": "TwitchAuth" },
			{ "name": "TWITCH_CHANNEL_OAUTH", "class_name": "TwitchChannelOAuthCoordinator" },
			{ "name": "TWITCH_CHANNEL_AUTH", "class_name": "TwitchChannelAuth" },
			{ "name": "TWITCH_EVENTSUB_MANAGER", "class_name": "TwitchEventSubManager" },
			{ "name": "TWITCH_EVENTSUB_SERVICE", "class_name": "TwitchEventSubService" },
			{ "name": "TWITCH_EVENTSUB_INBOX", "class_name": "TwitchEventSubInbox" },
			{ "name": "TWITCH_CHANNEL_REGISTRY", "class_name": "TwitchChannelRegistry" },
			{ "name": "INTEGRATION_REGISTRY", "class_name": "IntegrationRegistry" },
			{ "name": "INTEGRATION_COORDINATOR", "class_name": "IntegrationCoordinator" },
			{ "name": "SHAREABLE_STATE_REALM", "class_name": "ShareableStateRealm" },
			{ "name": "STATE_QUERY_OBSERVER", "class_name": "StateQueryObserver" },
			{ "name": "DURABLE_EVENT_STREAM", "class_name": "DurableEventStream" }
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GuildScheduler"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["GuildConfig"]
		},
		{
			"tag": "v3",
			"renamed_classes": [
				{ "from": "GuildConfig", "to": "GroupConfig" }
			]
		},
		{
			"tag": "v4",
			"renamed_classes": [
				{ "from": "GuildScheduler", "to": "GroupScheduler" }
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["TwitchAuth"]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": ["TwitchEventSubManager"]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": ["TwitchChannelOAuthCoordinator", "TwitchChannelAuth"]
		},
		{
			"tag": "v8",
			"new_sqlite_classes": ["TwitchChannelRegistry"]
		},
		{
			"tag": "v9",
			"new_sqlite_classes": ["TwitchEventSubService"]
		},
		{
			"tag": "v10",
			"new_sqlite_classes": ["TwitchAppAuth"]
		},
		{
			"tag": "v11",
			"new_sqlite_classes": ["IntegrationRegistry"]
		},
		{
			"tag": "v12",
			"new_sqlite_classes": ["IntegrationCoordinator"]
		},
		{
			"tag": "v13",
			"new_sqlite_classes": ["TwitchEventSubInbox"]
		},
		{
			"tag": "v14",
			"new_sqlite_classes": ["ShareableStateRealm"]
		},
		{
			"tag": "v15",
			"new_sqlite_classes": ["StateQueryObserver"]
		},
		{
			"tag": "v16",
			"new_sqlite_classes": ["DurableEventStream"]
		}
	],

	"env": {
		"test": {
			"vars": {
				"STATE_QUERY_STREAMS_ENABLED": "true",
				"STATE_QUERY_DIAGNOSTICS": "true",
				"STATE_QUERY_DEPLOYMENT_ENVIRONMENT": "test",
				"STATE_QUERY_PUBLIC_ORIGIN": "https://elmybot-worker-test.cutelmy.workers.dev",
				"DURABLE_EVENT_STREAMS_ENABLED": "true",
				"DURABLE_EVENT_DEPLOYMENT_ENVIRONMENT": "test",
				"DURABLE_EVENT_PUBLIC_ORIGIN": "https://elmybot-worker-test.cutelmy.workers.dev",
				"TWITCH_DEPLOYMENT_ENVIRONMENT": "test",
				"TWITCH_PUBLIC_ORIGIN": "https://elmybot-worker-test.cutelmy.workers.dev"
			},
			"durable_objects": {
				"bindings": [
					{ "name": "SCHEDULER", "class_name": "GroupScheduler" },
					{ "name": "CONFIG", "class_name": "GroupConfig" },
					{ "name": "TWITCH_APP_AUTH", "class_name": "TwitchAppAuth" },
					{ "name": "TWITCH_AUTH", "class_name": "TwitchAuth" },
					{ "name": "TWITCH_CHANNEL_OAUTH", "class_name": "TwitchChannelOAuthCoordinator" },
					{ "name": "TWITCH_CHANNEL_AUTH", "class_name": "TwitchChannelAuth" },
					{ "name": "TWITCH_EVENTSUB_MANAGER", "class_name": "TwitchEventSubManager" },
					{ "name": "TWITCH_EVENTSUB_SERVICE", "class_name": "TwitchEventSubService" },
					{ "name": "TWITCH_EVENTSUB_INBOX", "class_name": "TwitchEventSubInbox" },
					{ "name": "TWITCH_CHANNEL_REGISTRY", "class_name": "TwitchChannelRegistry" },
					{ "name": "INTEGRATION_REGISTRY", "class_name": "IntegrationRegistry" },
					{ "name": "INTEGRATION_COORDINATOR", "class_name": "IntegrationCoordinator" },
					{ "name": "SHAREABLE_STATE_REALM", "class_name": "ShareableStateRealm" },
					{ "name": "STATE_QUERY_OBSERVER", "class_name": "StateQueryObserver" },
					{ "name": "DURABLE_EVENT_STREAM", "class_name": "DurableEventStream" }
				]
			}
		}
	}
}
